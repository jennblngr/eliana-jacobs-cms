{
  "kind": "collectionType",
  "collectionName": "categories",
  "info": {
    "singularName": "category",
    "pluralName": "categories",
    "displayName": "Category",
    "description": ""
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "placeholder": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images"
      ]
    },
    "index": {
      "type": "integer",
      "required": true,
      "unique": true,
      "default": 1,
      "min": 1
    },
    "projects": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::project.project",
      "mappedBy": "category"
    },
    "isLightTheme": {
      "type": "boolean",
      "default": false,
      "required": true
    },
    "defaultLayout": {
      "type": "enumeration",
      "enum": [
        "list",
        "gallery"
      ],
      "required": true,
      "default": "list"
    },
    "types": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::type.type",
      "inversedBy": "categories"
    }
  }
}
